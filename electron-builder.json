{
  "appId": "com.vl.optimizer",
  "productName": "VL Optimizer",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "asarUnpack": [
    "bin/**",
    "native/**",
    "assets/**"
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "npmRebuild": false,
  "electronLanguages": [
    "pt-BR"
  ],
  "files": [
    "package.json",
    "main.js",
    "preload.js",
    "engine.js",
    "engine-extras.js",
    "engine-scaler.js",
    "engine-bridge.js",
    "updater.js",
    "assinatura-update.js",
    "supabase.js",
    "telemetria.js",
    "hwid.js",
    "lossless-official.js",
    "escrever-settings.js",
    "gdz-launch.js",
    "features.js",
    "elevacao.js",
    "notas-versao.js",
    "foto-sistema.js",
    "restaurar-sistema.js",
    "snapshot.ps1",
    "restore.ps1",
    "drs.ps1",
    "painel-live.ps1",
    "engine-disco.js",
    "marca.js",
    "marca/usada.json",
    "assets/**/*",
    "!assets/clientes/**",
    "src/**/*",
    "bin/**/*",
    "native/lossless/**/*",
    "native/scaler/fsr1_engine.cjs",
    "native/scaler/fsr1_engine.exe",
    "native/scaler/src/fsr1_con.js",
    "native/scaler/shaders/*.cso",
    "LEIA-ME.txt",
    "FSR.LICENSE.txt"
  ],
  "publish": [
    {
      "provider": "generic",
      "url": "https://vl-optimizer.pages.dev/atualizacoes"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "Instalar-VL-Optimizer-${version}.${ext}",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "include": "instalador-tarefa.nsh",
    "oneClick": false,
    "allowToChangeInstallationDirectory": false,
    "perMachine": false,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "VL Optimizer",
    "uninstallDisplayName": "VL Optimizer",
    "installerLanguages": [
      "pt_BR"
    ],
    "language": "1046",
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeaderIcon": "assets/icon.ico",
    "installerHeader": "instalador/installerHeader.bmp",
    "installerSidebar": "instalador/installerSidebar.bmp"
  },
  "artifactName": "Instalar-VL-Optimizer-${version}.${ext}"
}
