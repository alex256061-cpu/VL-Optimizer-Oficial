<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hospedeiro do motor Lossless para o VL Optimizer.
       Compila um processo de console que carrega o Lossless.dll e conversa por stdin/stdout em JSON.
       O Electron inicia este processo em vez de carregar o motor dentro de si: assim um motor que
       falhe não derruba a janela do app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VLScalingHost</AssemblyName>
    <RootNamespace>VLScalingHost</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
